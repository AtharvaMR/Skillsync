# SkillSync Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real API keys to version control.

# Google Gemini API Key (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for authentication
JWT_SECRET=change-this-to-a-secure-random-secret

# Application
NEXT_PUBLIC_APP_NAME=SkillSync
NEXT_PUBLIC_APP_TAGLINE=Better Skills. Better Jobs. Stronger Bharat.
NEXT_PUBLIC_DEMO_MODE=true

# Database
DATABASE_URL=file:./dev.db
