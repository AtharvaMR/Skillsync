# SkillSync Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real API keys to version control.

# Google Gemini API Key (AI Skill Intelligence Engine — server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (AI Career Assistant / Chatbot — server-side only)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (Semantic Skill Matching Engine — server-side only)
COHERE_API_KEY=your_cohere_api_key_here

# JWT Secret for authentication (use a 64+ char random hex string)
JWT_SECRET=change-this-to-a-secure-random-secret

# Application
NEXT_PUBLIC_APP_NAME=SkillSync
NEXT_PUBLIC_APP_TAGLINE=Proof of Skill. Path to Opportunity.
NEXT_PUBLIC_DEMO_MODE=true

# Database
DATABASE_URL=file:./dev.db
